{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(vitest:*)",
      "Bash(jest:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(mkfs:*)",
      "Bash(diskutil eraseDisk:*)",
      "Bash(diskutil eraseVolume:*)",
      "Bash(sudo:*)",
      "Bash(passwd:*)",
      "Bash(ssh:*)",
      "Bash(telnet:*)",
      "WebFetch(domain:*.internal)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "执行 Bash 命令前确认：\n1. 命令是只读操作还是会产生变更？\n2. 如果产生变更，确认是否符合项目规范。\n3. 危险的破坏性命令（如 rm -rf、git reset --hard）需先询问用户。"
          }
        ]
      }
    ]
  },
  "rules": {
    "alwaysApply": true
  },
  "diagnostics": {
    "enabled": true,
    "providers": {
      "eslint": {
        "enabled": true,
        "fix": true
      },
      "prettier": {
        "enabled": true,
        "formatOnSave": false
      },
      "tsconfig": {
        "enabled": true
      }
    }
  },
  "mcpServers": {},
  "experimental": {}
}
