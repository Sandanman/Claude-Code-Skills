/*
 * Claude Code 项目级配置
 *
 * 此文件为通用模板，可直接复制到任何项目中使用。
 * 复制后根据项目需要调整注释中标有 [可调整] 的配置项。
 *
 * 文档：https://docs.anthropic.com/zh-CN/docs/claude-code/settings-json
 */

{
  // ─────────────────────────────────────────────
  // 模型配置
  // ─────────────────────────────────────────────

  "model": "sonnet",

  // ─────────────────────────────────────────────
  // 权限配置
  // [可调整] 根据项目需求增删权限项
  // ─────────────────────────────────────────────

  "permissions": {
    "allow": [
      // 文件读写
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      // 任务管理
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      // Bash — 通用命令
      "Bash(ls *|cat|head|tail|grep|find|mkdir|rm|cp|mv|touch|chmod)",
      "Bash(git status|git diff|git log|git branch|git checkout)",
      "Bash(npm *|yarn *|pnpm *|node *|npx *)",
      "Bash(eslint *|prettier *|vitest *|jest *)",
      // 网络访问（根据项目需要调整域名）
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      // 默认禁止危险操作
      "Bash(rm -rf /|mkfs|format|sudo|passwd|ssh|telnet)",
      "WebFetch(domain: *://*.internal *)"
    ]
  },

  // ─────────────────────────────────────────────
  // 自动执行钩子
  // [可调整] 根据项目需要修改检查提示
  // ─────────────────────────────────────────────

  "hooks": {
    "pre-tool-use": [
      {
        "match": "Bash",
        "prompt": "执行 Bash 命令前确认：\n1. 命令是只读操作还是会产生变更？\n2. 如果产生变更，确认是否符合项目规范。\n3. 危险的破坏性命令（如 rm -rf、git reset --hard）需先询问用户。"
      },
      {
        "match": "Write|Edit",
        "prompt": "写入或编辑文件前确认：\n1. 文件路径正确，目标位置符合项目结构。\n2. 内容符合 .claude/rules/ 中的编码规范。\n3. 如果是配置文件，确认格式正确。"
      }
    ],
    "pre-command": [
      {
        "match": "git commit",
        "prompt": "提交前检查：\n1. 变更内容是否符合编码规范（参考 .claude/rules/coding-standards.mdc）\n2. 提交信息是否在 10 字以内，抽象概括核心变更\n3. 是否有未提交的敏感信息（如 token、密钥）\n4. 建议先运行 git status 查看变更范围"
      },
      {
        "match": "git push",
        "prompt": "推送前检查：\n1. 确认所有变更已提交（git status 无遗漏）\n2. 确认推送的分支和目标仓库正确\n3. 如果是强制推送（--force），需额外确认"
      },
      {
        "match": "Bash(mkdir|touch|rm|mv|cp)",
        "prompt": "这是一个文件操作命令，确认：\n1. 路径正确，符合项目目录结构\n2. 不会意外覆盖或删除重要文件\n3. 如果是删除操作，确认文件是否已被其他方式备份"
      }
    ],
    "post-command": [
      {
        "match": "git commit",
        "prompt": "提交完成后：建议运行 git log --oneline -3 查看最近的提交记录，确认提交成功。"
      }
    ],

    // ─────────────────────────────────────────────
    // 上下文压缩管理
    //
    // 说明：Claude Code 通过 PreCompact/PostCompact 自动管理上下文压缩，
    // 压缩时机由 Claude Code 内部算法决定（非 90% 显式阈值）。
    // 此处配置压缩前后的提示行为，以及会话结束时的限制提醒。
    //
    // 可见通知策略：
    //   - 使用 command 类型 echo 保证终端可见
    //   - 使用 notification 类型（部分客户端支持弹窗）
    // ─────────────────────────────────────────────

    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\n⚠️  上下文管理提醒：单次会话上下文有限，复杂任务完成后建议新建会话来获得最佳效果。\n    如需压缩上下文，可使用 /compact 命令。\n'"
          }
        ]
      }
    ],

    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\n🔄  上下文即将超过限制，系统将自动压缩上下文...'"
          },
          {
            "type": "prompt",
            "prompt": "上下文压缩即将触发。Claude Code 将自动压缩上下文以继续任务。\n压缩前请：\n1. 记住当前任务的关键状态和进度\n2. 记住待完成的关键步骤\n3. 压缩完成后，如需要关键上下文（任务目标、文件路径、待完成步骤），请告知我，我会从项目文件和记忆系统中恢复"
          }
        ]
      }
    ],

    "PostCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\n✅  上下文压缩完成，任务已继续执行。'"
          },
          {
            "type": "prompt",
            "prompt": "上下文压缩完成。任务继续执行。如果需要恢复关键上下文（任务目标、文件路径、待完成步骤），请告知我，我会从项目文件和记忆系统中恢复。"
          }
        ]
      }
    ],

    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\n⚠️  【重要】上下文即将超过最大限制，建议开始新的任务以获得最佳体验。\n    复杂任务建议分阶段执行，每阶段完成后新建会话。'"
          },
          {
            "type": "notification",
            "notification": "上下文即将超过最大限制，建议开始新的任务"
          }
        ]
      }
    ],

    // 通知钩子：当 Claude 等待输入且上下文接近限制时显示提醒
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "如果当前上下文使用量已接近最大限制，请在下次回复开始时提示用户：「⚠️  上下文使用量较高，建议使用 /compact 压缩或开始新任务以保持最佳性能。」"
          }
        ]
      }
    ]
  },

  // ─────────────────────────────────────────────
  // 规则加载配置
  // ─────────────────────────────────────────────

  "rules": {
    // true = rules 目录下的规则会自动加载（alwaysApply: true 的规则始终生效）
    "alwaysApply": true
  },

  // ─────────────────────────────────────────────
  // Slash Commands（斜杠命令）
  // [可调整] 对应各主 Skill 的快捷入口
  // ─────────────────────────────────────────────

  "commands": [
    {
      "name": "bug-solver",
      "description": "系统化地解决应用程序中的bug，通过7个原子Skill协同工作，从问题识别到修复验证（v1.3 τ 增强版，整合 Task Folding、Skill Stacking、Pattern Mining）"
    },
    {
      "name": "code-generator",
      "description": "根据需求文档或需求描述自动生成符合项目规范的代码（v1.3 τ 增强版，整合 Task Folding、Skill Stacking、Pattern Mining）"
    },
    {
      "name": "code-optimizer",
      "description": "系统化地优化代码（v2.0 τ 增强版），整合代码质量分析、性能优化和冗余检测，通过 τ-Agent 监控（Task Folding、Skill Stacking、Pattern Mining）提升优化效率"
    },
    {
      "name": "code-style-generator",
      "description": "自动检测项目代码规范，生成个人代码习惯文档 CODE_STYLE.md"
    },
    {
      "name": "scan-object-info",
      "description": "智能扫描并分析前端项目的各种技术信息（框架、UI库、状态管理等）"
    },
    {
      "name": "requirement-generator",
      "description": "将用户自然语言需求转化为标准化、可执行的机器需求文档（requirements.json）"
    },
    {
      "name": "security-scanner",
      "description": "系统化地扫描前端项目中的安全漏洞，包括XSS、CSRF、依赖漏洞、敏感信息泄露等"
    },
    {
      "name": "test-generator",
      "description": "根据现有代码或需求自动生成测试用例，覆盖单元测试、集成测试和E2E测试"
    },
    {
      "name": "doc-generator",
      "description": "自动生成代码文档，包括API文档、README、组件文档、变更日志等"
    },
    {
      "name": "git-assistant",
      "description": "智能 Git 操作助手，支持 commit 生成、分支管理、历史分析、冲突解决、版本管理"
    },
    {
      "name": "deploy-helper",
      "description": "辅助部署操作，支持Docker配置、CI/CD流水线生成、环境配置、部署脚本生成"
    },
    {
      "name": "orchestrator-pro",
      "description": "智能调度总控（τ 增强版，唯一入口），complexity<4 自动走轻量路径，complexity≥4 走完整 τ 优化路径"
    }
  ],

  // ─────────────────────────────────────────────
  // 自动保存
  // [可调整] 大型项目可关闭以提升性能
  // ─────────────────────────────────────────────

  "auto-save": true,

  // ─────────────────────────────────────────────
  // 对话历史
  // [可调整] maxSessions 为最大保留会话数
  // ─────────────────────────────────────────────

  "history": {
    "maxSessions": 50
  },

  // ─────────────────────────────────────────────
  // 诊断配置
  // [可调整] 根据项目使用的工具链增删 providers
  // ─────────────────────────────────────────────

  "diagnostics": {
    "enabled": true,
    "providers": {
      "eslint": {
        "enabled": true,
        "fix": true
      },
      "prettier": {
        "enabled": true,
        "formatOnSave": false
      },
      "tsconfig": {
        "enabled": true
      }
    }
  },

  // ─────────────────────────────────────────────
  // 断点恢复配置
  // [可调整] resume 命令的默认提示词
  // ─────────────────────────────────────────────

  "resume": {
    "prompt": "继续上一个任务。请先回顾之前的对话上下文，恢复到上次离开的位置继续工作。确认当前状态后，简要说明下一步计划。"
  },

  // ─────────────────────────────────────────────
  // MCP 服务器配置（可选）
  // [可调整] 根据项目需要启用，常见：文件系统、GitHub、Slack 等
  // ─────────────────────────────────────────────

  "mcpServers": {
    // 文件系统 MCP（提供更安全的文件访问控制）
    // "filesystem": {
    //   "command": "npx",
    //   "args": ["-y", "@modelcontextprotocol/server-filesystem", "./src"]
    // },
    // GitHub MCP（集成 GitHub API）
    // "github": {
    //   "command": "npx",
    //   "args": ["-y", "@modelcontextprotocol/server-github"],
    //   "env": {
    //     "GITHUB_TOKEN": "${GITHUB_TOKEN}"
    //   }
    // }
  },

  // ─────────────────────────────────────────────
  // 实验性功能
  // [可调整] 根据 Claude Code 版本和需求启用
  // ─────────────────────────────────────────────

  "experimental": {
    // 预提交检查（自动在 git commit 前运行 lint/test）
    // "precommit": {
    //   "enabled": true,
    //   "commands": ["npm run lint", "npm run test"],
    //   "failOnError": true
    // }
  }
}